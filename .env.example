# Copy this file to .env.local and fill in the real values.
# .env.local is gitignored — never commit it.
#
# Both values come from the Supabase dashboard:
#   Project Settings -> API
#
# The anon key may be labelled "Publishable key" in newer dashboards.
# It is SAFE for this key to reach the browser: it carries no privileges of its
# own, and Row Level Security decides what each logged-in user can read.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Optional, local development only: skip signing in entirely.
#
# Set this to employee, manager, or bookkeeper and the app treats every request
# as that role in a fake company, so the pages under app/(app) can be built
# without an invite, a password, or a sign-in email. Unset it to get the real
# login back.
#
# It is ignored in a production build, and has no NEXT_PUBLIC_ prefix so it
# never reaches the browser. Because it hands out a session to anyone who asks,
# it must stay out of any deployed environment.
#
# Data reads still run as an anonymous visitor, so Row Level Security returns
# nothing. This unblocks the UI, not real queries.
# DEV_AUTH_ROLE=bookkeeper

# DO NOT add the service_role (or "secret") key here.
# It bypasses Row Level Security completely. Anything named NEXT_PUBLIC_* is
# compiled into the JavaScript that every visitor downloads, so putting the
# service_role key in this file would hand every visitor full database access.
# When we eventually need it (user invites, cron jobs), it goes in a
# server-only variable with no NEXT_PUBLIC_ prefix.
